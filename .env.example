# FINANZA — variables de entorno locales (copiar a .env y ajustar)
# .env NO se versiona (ver .gitignore). Nunca subir secretos reales.

# --- Base de datos local aislada -------------------------------------------
# Puerto 55432 para no chocar con otros Postgres de la máquina.
FINANZA_DB_USER=finanza_app
FINANZA_DB_PASSWORD=CAMBIAR_ESTE_VALOR
FINANZA_DB_NAME=finanza
FINANZA_DB_PORT=55432

DATABASE_URL=postgresql://finanza_app:CAMBIAR_ESTE_VALOR@localhost:55432/finanza?schema=public

# --- API -------------------------------------------------------------------
FINANZA_API_PORT=3010
NODE_ENV=development

# Secretos JWT: generar con
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CAMBIAR_ESTE_VALOR
JWT_REFRESH_SECRET=CAMBIAR_ESTE_VALOR
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
# Ventana de operación offline (horas) desde la última autorización válida.
OFFLINE_WINDOW_HOURS=24

# --- Web -------------------------------------------------------------------
FINANZA_WEB_PORT=5180
VITE_API_URL=http://localhost:3010/api/v1

# --- Web Push (VAPID) ------------------------------------------------------
# Generar con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
