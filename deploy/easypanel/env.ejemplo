# FINANZA — variables para EasyPanel
# Se pegan en la pestaña «Environment» del servicio (Stack).
# NUNCA suba este archivo relleno al repositorio.

# --- Base de datos (modo con base incluida) --------------------------------
FINANZA_DB_USER=finanza_app
FINANZA_DB_PASSWORD=CAMBIE_ESTO_por_una_clave_larga
FINANZA_DB_NAME=finanza

# --- Base de datos (modo con su PostgreSQL del panel, p. ej. «studio») ------
# Use esto SOLO con docker-compose.produccion.base-existente.yml
# En el servidor 31.97.99.70 la base ya está creada (host verificado desde la red
# del proyecto). La contraseña está en /root/finanza-db-credentials.txt:
#   DATABASE_URL=postgresql://finanza_user:LA_CLAVE@ventas_studio-db:5432/finanza?schema=public

# --- Secretos de sesión (obligatorios) --------------------------------------
# Genérelos con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- Sesión y trabajo sin conexión -----------------------------------------
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
SESSION_MAX_HOURS=720
SESSION_IDLE_HOURS=168
OFFLINE_WINDOW_HOURS=24

# --- Dominio público (obligatorio para CORS y para las cookies) -------------
# Sin el https:// y sin barra final. Ejemplo: https://finanzas.midominio.com
CORS_ORIGINS=

# Cookies: «lax» sirve porque la app y la API comparten dominio.
COOKIE_SAMESITE=lax

# Saltos de proxy de confianza (nginx + proxy del panel = 1 es suficiente).
TRUST_PROXY=1

# --- Notificaciones push (opcional) ----------------------------------------
# Genérelas con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@midominio.com
