# Copiar a .env (no se versiona)
DATABASE_URL=postgresql://finanza_app:CAMBIAR_ESTE_VALOR@localhost:55432/finanza?schema=public
NODE_ENV=development
PORT=3010

# Generar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CAMBIAR_ESTE_VALOR
JWT_REFRESH_SECRET=CAMBIAR_ESTE_VALOR
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
OFFLINE_WINDOW_HOURS=24

# Timezone de negocio (fechas de negocio y cierres diarios)
BUSINESS_TIMEZONE=America/Santo_Domingo
DEFAULT_CURRENCY=DOP

# CORS: orígenes permitidos, separados por coma
CORS_ORIGINS=http://localhost:5180,http://localhost:4173

# Web Push (opcional). Sin claves, el push queda preparado pero desactivado.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Directorio de adjuntos (comprobantes)
ATTACHMENTS_DIR=./.datos-locales/adjuntos
MAX_ATTACHMENT_MB=8
