{
  "name": "finanza-api",
  "version": "1.0.0",
  "private": true,
  "description": "FINANZA — API de control financiero personal y empresarial (NestJS + Prisma + PostgreSQL)",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"prisma.config.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"prisma.config.ts\"",
    "prisma:generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "db:seed": "nest build && node dist/scripts/seed.js",
    "db:reset-password": "nest build && node dist/scripts/reset-password.js",
    "db:set-credentials": "nest build && node dist/scripts/set-credentials.js",
    "seed:demo": "nest build && node dist/scripts/demo-seed.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.json",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.json --watch",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.json --coverage",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config test/jest-e2e.json --runInBand",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run test:e2e && npm run build"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.3",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "^8.1.0",
    "luxon": "^3.7.2",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.7",
    "@nestjs/testing": "12.1.3",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.10.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.39.1",
    "jest": "30.5.2",
    "prettier": "^3.7.0",
    "prisma": "7.10.1",
    "supertest": "^7.1.4",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
